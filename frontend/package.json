{
  "name": "wudian-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-dev-port.ps1",
    "dev:clean": "npm run clean --silent && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-dev-port.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-next.ps1",
    "stage-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-check.ps1",
    "build": "next build",
    "build:clean": "npm run clean --silent && next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime-assets": "node tests/runtimeAssets.test.cjs",
    "start": "next start",
    "start:clean": "npm run stage-check --silent && next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.323.0",
    "next": "^15.5.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swr": "^2.2.4",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.26",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.33",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
