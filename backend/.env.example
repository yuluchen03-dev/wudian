# ============================================
# 悟典 - 四书五经互动学习平台
# 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================

# --- 应用配置 ---
APP_NAME=悟典
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- 数据库配置 (PostgreSQL) ---
POSTGRES_USER=wudian
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wudian_db
DATABASE_URL=postgresql+asyncpg://wudian:your_password_here@localhost:5432/wudian_db

# --- Redis 缓存 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT 认证 ---
JWT_SECRET_KEY=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI / AI 配置 ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM Provider ---
# Supports: openai / agnes / deepseek / qwen / local
LLM_PROVIDER=openai

# --- Agnes AI (OpenAI-compatible) ---
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# --- 向量数据库 (ChromaDB) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=wudian_verses

# --- CORS 配置 ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- SRS 间隔重复算法配置 ---
SRS_INITIAL_EASE_FACTOR=2.5
SRS_MINIMUM_EASE_FACTOR=1.3
SRS_INITIAL_INTERVAL=1
SRS_EASY_BONUS=1.3
