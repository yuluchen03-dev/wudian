        "avatar_keyword": "大学生，文静内敛"
      }
    ],
    "scenes": [
      {
        "title": "第一幕：分工争论",
        "setting": "大学宿舍，期末小组作业讨论现场",
        "lines": [
          {
            "role": "子路哥",
            "text": "好了好了，作业分工我定了：小回负责写五千字论文主体，阿贡做 PPT 和演讲，我嘛……负责统筹协调。",
            "emotion": "(拍桌子，一锤定音)"
          },
          {
            "role": "阿贡",
            "text": "等等，你的'统筹协调'具体是干啥？",
            "emotion": "(推眼镜)"
          },
          {
            "role": "子路哥",
            "text": "就是……看看进度，提提意见，当个组长嘛！",
            "emotion": "(理直气壮)"
          },
          {
            "role": "阿贡",
            "text": "所以最难的五千字给小回，最累的演讲给我，你只负责'看'和'说'？",
            "emotion": "(冷笑)"
          },
          {
            "role": "子路哥",
            "text": "我这叫合理分工，发挥各自优势！",
            "emotion": "(强撑)"
          },
          {
            "role": "阿贡",
            "text": "子路哥，我问你，如果老师让你写五千字加做演讲，你愿意吗？",
            "emotion": "(正色)"
          },
          {
            "role": "子路哥",
            "text": "那肯定不愿意啊，我又不是超人。",
            "emotion": "(脱口而出)"
          },
          {
            "role": "阿贡",
            "text": "己所不欲，勿施于人。你自己都不想干的活，凭啥全甩给我们？",
            "emotion": "(严肃)",
            "is_original_verse": true
          },
          {
            "role": "子路哥",
            "text": "……",
            "emotion": "(语塞)"
          },
          {
            "role": "小回",
            "text": "其实……论文我可以写三千字，剩下两千大家分一下，PPT 我也能帮忙做几页。",
            "emotion": "(小声提议)"
          },
          {
            "role": "阿贡",
            "text": "对嘛，这样才公平。子路哥，你写两千字加统筹，我负责演讲和 PPT 框架，小回写主体。大家都有活干，也都扛得住。",
            "emotion": "(拍手)"
          },
          {
            "role": "子路哥",
            "text": "行吧行吧，是我不对。我这就去查资料写那两千字。",
            "emotion": "(挠头，不好意思)"
          },
          {
            "role": "阿贡",
            "text": "这才像个组长嘛。",
            "emotion": "(笑)"
          }
        ]
      }
    ],
    "moral": "团队合作的核心是公平与换位思考。把不想做的活推给别人，最终伤害的是团队凝聚力和自己的信誉。"
  },
  {
    "id": "th_004",
    "title": "温故而知新 —— 老员工的二次成长",
    "summary": "工作五年的老员工陷入瓶颈，被导师提醒重新梳理基础，在复习中发现新洞察。",
    "classical_source": "《论语·为政》",
    "modern_setting": "职场",
    "cover_keyword": "咖啡馆里两人对坐讨论，一人翻看旧笔记本，水墨融合",
    "like_count": 67,
