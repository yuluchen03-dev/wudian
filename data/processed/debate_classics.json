        {
          "id": "lunyu-weilinggong-01",
          "chapter": "卫灵公",
          "source": "《论语·卫灵公》",
          "original": "君子谋道不谋食。",
          "translation": "君子谋求的是道义，不只是口腹生计。",
          "keywords": ["君子", "谋道", "价值", "工作", "人生", "金钱"]
        }
      ]
    },
    "laozi": {
      "book": "道德经",
      "verses": [
        {
          "id": "daodejing-22-01",
          "chapter": "第二十二章",
          "source": "《道德经·第二十二章》",
          "original": "夫唯不争，故天下莫能与之争。",
          "translation": "正因为不与人争，所以天下反而没有谁能与他相争。",
          "keywords": ["不争", "自在", "放下", "躺平", "内卷", "争胜", "顺势"]
        },
        {
          "id": "daodejing-33-01",
          "chapter": "第三十三章",
          "source": "《道德经·第三十三章》",
          "original": "知人者智，自知者明。",
          "translation": "了解别人是智慧，了解自己才是明达。",
          "keywords": ["自知", "明", "选择", "人生", "困惑", "判断"]
        },
        {
          "id": "daodejing-44-01",
          "chapter": "第四十四章",
          "source": "《道德经·第四十四章》",
          "original": "知足不辱，知止不殆，可以长久。",
          "translation": "知道满足就不会受辱，知道止步就不会危险，因此可以长久。",
          "keywords": ["知足", "知止", "长久", "焦虑", "欲望", "退守", "躺平"]
        },
        {
          "id": "daodejing-08-01",
          "chapter": "第八章",
          "source": "《道德经·第八章》",
          "original": "上善若水，水善利万物而不争。",
          "translation": "最高的善像水一样，善于利益万物而不争夺。",
          "keywords": ["不争", "柔弱", "水", "处世", "安放", "顺道"]
        }
      ]
    },
