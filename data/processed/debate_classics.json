    "li_bai": {
      "book": "李白诗文",
      "verses": [
        {
          "id": "libai-jiangjinjiu-01",
          "chapter": "将进酒",
          "source": "《将进酒》",
          "original": "人生得意须尽欢，莫使金樽空对月。",
          "translation": "人生得意时应当尽情欢畅，不要让金杯空对明月。",
