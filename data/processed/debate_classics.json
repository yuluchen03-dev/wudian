      "book": "范仲淹文",
      "verses": [
        {
          "id": "fanzhongyan-yueyanglouji-01",
          "chapter": "岳阳楼记",
          "source": "《岳阳楼记》",
          "original": "先天下之忧而忧，后天下之乐而乐。",
          "translation": "在天下人忧虑之前先忧虑，在天下人快乐之后才快乐。",
          "keywords": ["家国", "责任", "担当", "天下", "忧乐"]
        }
      ]
