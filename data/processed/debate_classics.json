      "verses": [
        {
          "id": "wanganshi-dengfeilaifeng-01",
          "chapter": "登飞来峰",
          "source": "《登飞来峰》",
          "original": "不畏浮云遮望眼，自缘身在最高层。",
          "translation": "不怕浮云遮住远望的眼睛，只因为自己站在最高处。",
          "keywords": ["变法", "视野", "阻力", "实干", "改变"]
