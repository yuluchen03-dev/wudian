  "matching": {
    "algorithm": "deterministic_substring_v1",
    "description": "对输入文本做归一化后，逐个 scene 统计其 triggers 的命中；每条命中贡献 len(trigger) 分，scene 得分再乘以其 specificity。得分最高者为 primary scene。不调用任何 LLM 或网络。",
    "normalization": ["strip", "lowercase", "remove_whitespace"],
    "score_formula": "score(scene) = specificity(scene) * sum(len(trigger) for trigger in triggers if trigger in normalized_input)",
    "confidence_formula": "confidence = min(1.0, score / confidence_full_score)",
    "confidence_full_score": 5.0,
    "confidence_calibration": "单个 2 字特征触发词 → 0.40（达到可归类门槛）；2 个以上或更长触发词 → 0.6–1.0；仅命中泛化触发词（如 choice 的「该不该」）→ < 0.4，标记 needs_clarification。",
    "secondary_scene_ratio": 0.5,
    "note": "confidence < 0.4 时 needs_clarification=true，表示结构化结果不确定，下游应降级而非强行检索。score == 0 时 scene=null、confidence=0.0，禁止硬编归类。"
  },

