  "concepts": {
    "仁": {"school": "儒家", "gloss": "对他人的关爱与推己及人，儒家最高德目。"},
    "义": {"school": "儒家", "gloss": "合宜、正当；判断当为与不当为的准则。"},
    "礼": {"school": "儒家", "gloss": "社会秩序与行为规范、仪节，含恭敬与节度。"},
    "智": {"school": "儒家", "gloss": "明辨是非、审察情实的判断力（三达德之一）。"},
    "信": {"school": "儒家", "gloss": "诚实不欺、言行一致；亦为法家所重之信用。"},
    "孝": {"school": "儒家", "gloss": "对父母的敬养与承顺。"},
    "悌": {"school": "儒家", "gloss": "敬爱兄长，引申为同辈间的敬让。"},
    "忠": {"school": "儒家", "gloss": "尽己之心以待人处事。"},
    "恕": {"school": "儒家", "gloss": "推己及人，「己所不欲，勿施于人」。"},
    "勇": {"school": "儒家", "gloss": "见义而为的胆识（三达德之一）；非血气之勇。"},
    "慈": {"school": "儒家", "gloss": "上对下的仁爱，与「孝」相对（父慈子孝）。"},
    "友": {"school": "儒家", "gloss": "朋友一伦与其相处之道（朋友有信）。"},
    "均": {"school": "儒家", "gloss": "分配上的均衡，「不患寡而患不均」。"},
    "正名": {"school": "儒家", "gloss": "名分与实责相符，使言行有据（孔子）。"},
    "名实": {"school": "儒家/法家/名家", "gloss": "名义与实际是否相符；名实相符则事定。"},
    "中庸": {"school": "儒家", "gloss": "不偏不倚、无过无不及的处事之道。"},
    "诚": {"school": "儒家", "gloss": "真实无妄、内外一致（《中庸》《孟子》）。"},
    "学": {"school": "儒家", "gloss": "学习与修养的持续过程。"},
    "志": {"school": "儒家", "gloss": "心之所向、立定的志向。"},
    "修身": {"school": "儒家", "gloss": "自我修养，「自天子以至于庶人，壹是皆以修身为本」。"},
    "慎独": {"school": "儒家", "gloss": "独处时亦不放纵，内在自律。"},
    "利": {"school": "儒家", "gloss": "利益、功利；与「义」相对，构成义利之辨。"},
    "不争": {"school": "道家", "gloss": "不与人争胜，「夫唯不争，故天下莫能与之争」。"},
    "无为": {"school": "道家", "gloss": "顺任自然、不妄加干预。"},
    "自然": {"school": "道家", "gloss": "事物本然如此的状态。"},
    "知足": {"school": "道家", "gloss": "知道满足，「知足不辱，知止不殆」。"},
    "柔弱": {"school": "道家", "gloss": "柔弱胜刚强，以柔韧处世的策略。"},
    "逍遥": {"school": "道家", "gloss": "无所依待的精神自由（《庄子》）。"},
    "齐物": {"school": "道家", "gloss": "齐同物论、超越是非对立（《庄子》）。"},
    "兼爱": {"school": "墨家", "gloss": "不分亲疏地爱他人（《墨子》）。"},
    "非攻": {"school": "墨家", "gloss": "反对侵略攻伐。"},
    "尚贤": {"school": "墨家", "gloss": "以贤能而非亲疏任人。"},
    "节用": {"school": "墨家", "gloss": "节制用度、反对奢费。"},
    "法": {"school": "法家", "gloss": "成文法令与制度约束。"},
    "势": {"school": "法家", "gloss": "权位与形势所构成的支配力。"},
    "术": {"school": "法家", "gloss": "君主驾驭臣下的方法与考核手段。"},
    "赏罚": {"school": "法家", "gloss": "以赏罚二柄驱动行为（《韩非子·二柄》）。"},
    "良知": {"school": "心学", "gloss": "心之本体，知善知恶的内在判断（王阳明）。"},
    "知行合一": {"school": "心学", "gloss": "知与行本为一事，不行不足以言知（王阳明）。"}
  },

